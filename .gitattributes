# Normalise line endings on the way into the repository. Development happens on
# Windows and CI runs on Linux; without this, every file one of them touches
# comes back as a whole-file diff.
* text=auto eol=lf

# Hunk headers that name the enclosing function rather than a random line of
# code, using git's built-in language drivers. There is no built-in driver for
# TypeScript, so .ts/.tsx are deliberately absent.
*.py    text diff=python
*.css   text diff=css
*.html  text diff=html
*.md    text diff=markdown

# Generated by npm, not written by anyone. Collapsed in GitHub diffs, excluded
# from the language statistics, and not worth reading line by line in review --
# but still committed, because the exact dependency tree is the point.
frontend/package-lock.json linguist-generated=true -diff
