{
  "name": "orbital-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "textures": "node scripts/copy-textures.mjs",
    "geography": "node scripts/build-geography.mjs",
    "airlines": "node scripts/build-airlines.mjs",
    "assets": "npm run textures && npm run geography && npm run airlines",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "globe.gl": "^2.35.0",
    "maplibre-gl": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@nwpr/airport-codes": "^3.0.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.0",
    "airline-codes": "^1.1.5",
    "all-the-cities": "^3.1.0",
    "d3-geo": "^3.1.1",
    "jsdom": "^25.0.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  }
}
