{
  "name": "orbital-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "textures": "node scripts/copy-textures.mjs",
    "airlines": "node scripts/build-airlines.mjs",
    "clouds": "node scripts/fetch-cloud-textures.mjs",
    "assets": "npm run textures && npm run clouds && npm run airlines",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.0",
    "airline-codes": "^1.1.5",
    "jsdom": "^25.0.0",
    "three-globe": "^2.45.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
