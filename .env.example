# Orbital backend configuration. Copy to backend/.env and fill in.
# .env is git-ignored; this file documents the names only. Never commit secrets.

# ---- data source ----
# fixture = offline replay, no credentials needed (the default, see D8)
# opensky = live, metered. Needs the credentials below for the 4000/day allowance
# adsblol = live, free and unauthenticated, but rate limited (see below)
# union   = both at once: adsb.lol every poll, OpenSky as a periodic supplement
#           for the aircraft adsb.lol cannot see. This is what we run (D83).
# satellites = a different layer entirely: positions computed from published
#           orbital elements, no credentials and no quota (D93, D94)
ORBITAL_PROVIDER=fixture

# ---- OpenSky OAuth2 client credentials ----
# Basic auth was removed upstream. Create an API client in your OpenSky account
# and paste the pair here. Leaving them empty still works, but drops you to the
# 400/day anonymous allowance.
ORBITAL_OPENSKY_CLIENT_ID=
ORBITAL_OPENSKY_CLIENT_SECRET=
# ORBITAL_OPENSKY_TIMEOUT_SECONDS=20.0

# ---- adsb.lol ----
# No credentials, which is most of its appeal. It is rate limited instead, and
# the limit was measured rather than published: a burst of 4 requests, then
# roughly one per 12 seconds. The provider paces itself to match, so a global
# sweep takes as long as it takes. Do not lower the interval without measuring
# again -- a burst cannot tell you the sustained rate.
# ORBITAL_ADSBLOL_BASE_URL=https://api.adsb.lol/v2
# ORBITAL_ADSBLOL_TIMEOUT_SECONDS=30.0
# Sent on every request; a free service deserves to know who is calling.
# ORBITAL_ADSBLOL_USER_AGENT=

# ---- union ----
# How often the metered feed is called when ORBITAL_PROVIDER=union. The free
# feed answers every poll; OpenSky answers at most this often, so the cadence is
# no longer set by the credit ladder. 120 s is the client's dead-reckoning
# limit: longer, and aircraft only OpenSky can see sit still (D71, D83).
# ORBITAL_UNION_SUPPLEMENT_INTERVAL_SECONDS=120.0

# ---- satellites ----
# Needs no credentials at all: every element source is free and unauthenticated.
# Positions are computed from orbital elements rather than fetched, so this
# provider spends no quota and keeps working offline once elements are cached.
# Turn the layer off entirely for a deployment that should make no outbound
# calls at all. On by default: it costs one background task and no quota.
# ORBITAL_SATELLITE_LAYER_ENABLED=true
# ORBITAL_SATELLITE_TIMEOUT_SECONDS=60
# How often elements are refetched. Hours, not seconds -- elements describe an
# orbit rather than a position and stay usable for days. Positions are still
# computed fresh on every poll.
# ORBITAL_SATELLITE_ELEMENT_REFRESH_SECONDS=21600
# Where elements are kept between runs, so a restart during an upstream outage
# still has something to propagate. Gitignored.
# ORBITAL_SATELLITE_ELEMENT_CACHE_PATH=.cache/orbital-elements.json

# ---- quota ----
# anonymous     400/day  -> globe every 20 min, no live tier
# authenticated 4000/day -> globe every 5 min + viewport every 45 s   (default)
# contributor   8000/day -> globe every 3 min + viewport every 30 s
# union                  -> globe every 120 s + viewport every 30 s. Paced by
#                           adsb.lol's rate limit, not by credits; it is
#                           budgeted against the 4000/day allowance.
# The arithmetic behind these is in docs/decisions.md, D21. Startup fails if the
# configured intervals project past the safety ceiling.
ORBITAL_QUOTA_PRESET=authenticated

# Override the published daily allowance. Leave unset unless you know why.
# ORBITAL_DAILY_CREDIT_BUDGET=

# Fraction of the allowance the configured jobs may project to consume.
# ORBITAL_BUDGET_SAFETY_FRACTION=0.85

# ---- tier 2 (viewport) tuning ----
# Trim the snapped viewport box to this area before polling. 25 sq deg is the
# top of the 1-credit band, so tier 2 always costs exactly one credit.
# ORBITAL_FOCUS_MAX_AREA_SQ_DEG=25.0
# Skip the viewport poll entirely above this area -- tier 1 already covers it.
# ORBITAL_FOCUS_SKIP_AREA_SQ_DEG=400.0
# ORBITAL_FOCUS_GRID_SNAP_DEG=1.0

# ---- store ----
# Staleness threshold. Unset derives it as twice the longest poll interval.
# ORBITAL_SNAPSHOT_TTL_SECONDS=
# Drop an aircraft no feed has re-observed within this window. It was 1800 s,
# back when one feed polled every 300 s; at the current cadence that kept a map
# where 39% of what was drawn had not been seen for two minutes (D86).
# ORBITAL_OBJECT_TTL_SECONDS=300
# ORBITAL_TRACK_HISTORY_POINTS=50

# ---- aircraft tracks ----
# Where a selected aircraft's flown path comes from. adsb.lol publishes static
# per-aircraft trace files covering the last 24 hours, which is why a track no
# longer begins when the aircraft entered our polling window and no longer dies
# with a restart (D200). Sharded by the last two hex characters of the address.
# The backend trims a day-long trace to the leg in progress (D201, D204-D206).
# ORBITAL_ADSBLOL_TRACE_BASE_URL=https://globe.adsb.lol/data/traces

# ---- ships ----
# Two sources, merged the same way the aircraft union is (D165, D171):
# Digitraffic is the Finnish transport agency's operational feed - no key, no
# meter, ~37 KB a minute, and it only covers the northern Baltic. aisstream is
# a global websocket that needs a key. Half of aisstream's coverage is the
# Baltic anyway, so Digitraffic stays the authority where the two overlap.
# ORBITAL_SHIP_LAYER_ENABLED=true
# ORBITAL_DIGITRAFFIC_TIMEOUT_SECONDS=

# The global AIS stream. Does nothing without a key, so the key is the switch.
# **Throw ORBITAL_SHIP_GLOBAL_ENABLED=false the day aisstream starts charging.**
# ORBITAL_AISSTREAM_API_KEY=
# ORBITAL_SHIP_GLOBAL_ENABLED=true

# How many vessels the ship store may hold. Ships arrive on a stream rather
# than a poll, so without a cap the store grows for as long as the process
# lives: it was still climbing through 27,000 when this was added, and memory
# with it. 14,000 is where a 512 MB container sits comfortably (D190).
# ORBITAL_SHIP_MAX_VESSELS=14000
# ORBITAL_SHIP_OBJECT_TTL_SECONDS=

# ---- the moon ----
# Computed from an ephemeris, like satellites: no feed, no key, no quota.
# ORBITAL_LUNAR_LAYER_ENABLED=true

# ---- accounts ----
# **The one piece of state that must outlive the process.** Aircraft, ships and
# satellites are all rebuilt from upstream within minutes of a restart; an
# account is gone for good. In the container this defaults to /srv/data, which
# needs a mounted volume or sign-ups do not survive a redeploy.
# ORBITAL_ACCOUNTS_DB_PATH=.cache/orbital-accounts.sqlite

# Set true wherever the site is served over HTTPS - it marks the session cookie
# Secure. Left false so that plain-HTTP localhost can still sign in.
# ORBITAL_COOKIES_SECURE=false
# ORBITAL_SELF_SERVE_PREMIUM=

# ---- serving ----
# Origins allowed to call this API. The default covers the Vite dev server
# only, so a deployed frontend on another origin must be named here or every
# browser request fails CORS. JSON array, e.g.
# ORBITAL_CORS_ORIGINS=["https://orbital-liveview.vercel.app"]
# ORBITAL_CORS_ORIGINS=

# Thinning cap: the most objects any one response may carry (D15).
# ORBITAL_MAX_OBJECTS_PER_RESPONSE=2000
# ORBITAL_GZIP_MIN_BYTES=1024
# ORBITAL_LOG_LEVEL=INFO
