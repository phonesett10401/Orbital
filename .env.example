# Orbital backend configuration. Copy to backend/.env and fill in.
# .env is git-ignored; this file documents the names only. Never commit secrets.

# ---- data source ----
# fixture = offline replay, no credentials needed (the default, see D8)
# opensky = live data, needs the credentials below for the 4000/day allowance
ORBITAL_PROVIDER=fixture

# ---- OpenSky OAuth2 client credentials ----
# Basic auth was removed upstream. Create an API client in your OpenSky account
# and paste the pair here. Leaving them empty still works, but drops you to the
# 400/day anonymous allowance.
ORBITAL_OPENSKY_CLIENT_ID=
ORBITAL_OPENSKY_CLIENT_SECRET=

# ---- quota ----
# anonymous     400/day  -> globe every 20 min, no live tier
# authenticated 4000/day -> globe every 5 min + viewport every 45 s   (default)
# contributor   8000/day -> globe every 3 min + viewport every 30 s
# The arithmetic behind these is in docs/decisions.md, D21. Startup fails if the
# configured intervals project past the safety ceiling.
ORBITAL_QUOTA_PRESET=authenticated

# Override the published daily allowance. Leave unset unless you know why.
# ORBITAL_DAILY_CREDIT_BUDGET=

# Fraction of the allowance the configured jobs may project to consume.
# ORBITAL_BUDGET_SAFETY_FRACTION=0.85

# ---- tier 2 (viewport) tuning ----
# Trim the snapped viewport box to this area before polling. 25 sq deg is the
# top of the 1-credit band, so tier 2 always costs exactly one credit.
# ORBITAL_FOCUS_MAX_AREA_SQ_DEG=25.0
# Skip the viewport poll entirely above this area -- tier 1 already covers it.
# ORBITAL_FOCUS_SKIP_AREA_SQ_DEG=400.0
# ORBITAL_FOCUS_GRID_SNAP_DEG=1.0

# ---- store ----
# Staleness threshold. Unset derives it as twice the longest poll interval.
# ORBITAL_SNAPSHOT_TTL_SECONDS=
# ORBITAL_OBJECT_TTL_SECONDS=1800
# ORBITAL_TRACK_HISTORY_POINTS=50
